// ============================================================================
//  IDENTITY, ACCESS CONTROL & AUDIT
// ============================================================================

model User {
  id                  String     @id @default(uuid()) @db.VarChar(36)
  email               String     @unique @db.VarChar(191)
  passwordHash        String     @db.VarChar(191)
  firstName           String     @db.VarChar(100)
  lastName            String     @db.VarChar(100)
  phone               String?    @db.VarChar(32)
  avatarUrl           String?    @db.VarChar(512)
  jobTitle            String?    @db.VarChar(120)
  status              UserStatus @default(PENDING_VERIFICATION)
  isDemo              Boolean    @default(false)
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  failedLoginCount    Int        @default(0)
  lockedUntil         DateTime?
  preferredLanguage   String     @default("fr") @db.VarChar(8)
  companyId           String?    @db.VarChar(36)
  createdById         String?    @db.VarChar(36)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  company                 Company?                 @relation("CompanyMembers", fields: [companyId], references: [id], onDelete: SetNull)
  createdBy               User?                    @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers            User[]                   @relation("UserCreator")
  ownedCompanies          Company[]                @relation("CompanyOwner")
  userRoles               UserRole[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  deviceTokens            DeviceToken[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  auditLogs               AuditLog[]
  forestsCreated          Forest[]                 @relation("ForestCreator")
  forestsManaged          Forest[]                 @relation("ForestManager")
  zonesCreated            ForestZone[]             @relation("ZoneCreator")
  protectedAreasCreated   ProtectedArea[]          @relation("ProtectedAreaCreator")
  speciesCreated          TreeSpecies[]            @relation("SpeciesCreator")
  inventoriesRecorded     TreeInventory[]          @relation("InventoryRecorder")
  permitsSubmitted        ExploitationPermit[]     @relation("PermitApplicant")
  permitsReviewed         ExploitationPermit[]     @relation("PermitReviewer")
  permitsApproved         ExploitationPermit[]     @relation("PermitApprover")
  permitStatusChanges     PermitStatusHistory[]
  permitDocuments         PermitDocument[]         @relation("PermitDocumentUploader")
  activitiesCreated       ExploitationActivity[]   @relation("ActivityCreator")
  activitiesAssigned      ExploitationActivity[]   @relation("ActivityAssignee")
  fieldSessions           FieldSession[]
  equipmentCreated        Equipment[]              @relation("EquipmentCreator")
  paymentsAsPayer         Payment[]                @relation("PaymentPayer")
  paymentsInitiated       Payment[]                @relation("PaymentInitiator")
  paymentsVerified        Payment[]                @relation("PaymentVerifier")
  inspectionsConducted    Inspection[]             @relation("InspectionInspector")
  inspectionsAssigned     Inspection[]             @relation("InspectionAssigner")
  inspectionsReviewed     Inspection[]             @relation("InspectionReviewer")
  observationsRecorded    FieldObservation[]       @relation("ObservationObserver")
  violationsDetected      EnvironmentalViolation[] @relation("ViolationDetector")
  violationsResolved      EnvironmentalViolation[] @relation("ViolationResolver")
  evidencesUploaded       Evidence[]               @relation("EvidenceUploader")
  reportsGenerated        Report[]                 @relation("ReportGenerator")
  aiAnalysesRequested     AIAnalysis[]             @relation("AnalysisRequester")
  aiAnalysesReviewed      AIAnalysis[]             @relation("AnalysisReviewer")
  aiAlertsReviewed        AIAlert[]                @relation("AlertReviewer")
  aiConversations         AIConversation[]
  gisLocations            GISLocation[]            @relation("LocationRecorder")
  companiesVerified       Company[]                @relation("CompanyVerifier")
  documentsUploaded       CompanyDocument[]        @relation("CompanyDocumentUploader")
  documentsVerified       CompanyDocument[]        @relation("CompanyDocumentVerifier")
  settingsUpdated         SystemSetting[]          @relation("SettingUpdater")
  assignedUserRoles       UserRole[]               @relation("RoleAssigner")

  @@index([companyId])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique @db.VarChar(64)
  label       String   @db.VarChar(120)
  description String?  @db.Text
  isSystem    Boolean  @default(true)
  level       Int      @default(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@index([level])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.VarChar(36)
  code        String   @unique @db.VarChar(96)
  module      String   @db.VarChar(48)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @db.VarChar(36)
  permissionId String   @db.VarChar(36)
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String    @db.VarChar(36)
  roleId       String    @db.VarChar(36)
  assignedById String?   @db.VarChar(36)
  assignedAt   DateTime  @default(now())
  expiresAt    DateTime?

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@map("user_roles")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.VarChar(36)
  userId            String    @db.VarChar(36)
  tokenHash         String    @unique @db.VarChar(191)
  family            String    @db.VarChar(36)
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @db.VarChar(36)
  ipAddress         String?   @db.VarChar(64)
  userAgent         String?   @db.VarChar(255)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([family])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @db.VarChar(36)
  tokenHash String    @unique @db.VarChar(191)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @db.VarChar(36)
  tokenHash String    @unique @db.VarChar(191)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model DeviceToken {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @db.VarChar(36)
  token      String   @unique @db.VarChar(191)
  platform   String   @db.VarChar(16)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model AuditLog {
  id          String        @id @default(uuid()) @db.VarChar(36)
  actorId     String?       @db.VarChar(36)
  actorEmail  String?       @db.VarChar(191)
  action      AuditAction
  severity    AuditSeverity @default(INFO)
  entityType  String?       @db.VarChar(64)
  entityId    String?       @db.VarChar(64)
  description String?       @db.VarChar(500)
  beforeJson  String?       @db.LongText
  afterJson   String?       @db.LongText
  ipAddress   String?       @db.VarChar(64)
  userAgent   String?       @db.VarChar(255)
  createdAt   DateTime      @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id          String           @id @default(uuid()) @db.VarChar(36)
  key         String           @unique @db.VarChar(96)
  value       String           @db.LongText
  category    SettingCategory  @default(GENERAL)
  valueType   SettingValueType @default(STRING)
  description String?          @db.VarChar(255)
  isSecret    Boolean          @default(false)
  updatedById String?          @db.VarChar(36)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  updatedBy User? @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([category])
  @@map("system_settings")
}

// ============================================================================
//  COMPANIES
// ============================================================================

model Company {
  id                 String        @id @default(uuid()) @db.VarChar(36)
  name               String        @unique @db.VarChar(191)
  registrationNumber String        @unique @db.VarChar(64)
  taxNumber          String?       @unique @db.VarChar(64)
  type               CompanyType
  status             CompanyStatus @default(PENDING)
  email              String        @db.VarChar(191)
  phone              String        @db.VarChar(32)
  alternatePhone     String?       @db.VarChar(32)
  addressLine        String        @db.VarChar(255)
  city               String        @db.VarChar(96)
  region             String        @db.VarChar(96)
  country            String        @default("Cameroun") @db.VarChar(96)
  website            String?       @db.VarChar(191)
  logoUrl            String?       @db.VarChar(512)
  latitude           Decimal?      @db.Decimal(10, 7)
  longitude          Decimal?      @db.Decimal(10, 7)
  employeeCount      Int?
  description        String?       @db.Text
  verifiedAt         DateTime?
  verifiedById       String?       @db.VarChar(36)
  rejectionReason    String?       @db.VarChar(500)
  ownerId            String?       @db.VarChar(36)
  isDemo             Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  owner      User?              @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  verifiedBy User?              @relation("CompanyVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  members    User[]             @relation("CompanyMembers")
  documents  CompanyDocument[]
  permits    ExploitationPermit[]
  activities ExploitationActivity[]
  equipment  Equipment[]
  payments   Payment[]
  inspections Inspection[]
  violations EnvironmentalViolation[]
  reports    Report[]
  aiAlerts   AIAlert[]
  evidences  Evidence[]

  @@index([status])
  @@index([type])
  @@index([region])
  @@index([deletedAt])
  @@map("companies")
}

model CompanyDocument {
  id           String       @id @default(uuid()) @db.VarChar(36)
  companyId    String       @db.VarChar(36)
  type         DocumentType
  title        String       @db.VarChar(191)
  fileUrl      String       @db.VarChar(512)
  fileKey      String       @db.VarChar(255)
  mimeType     String       @db.VarChar(120)
  sizeBytes    Int
  checksum     String?      @db.VarChar(64)
  isVerified   Boolean      @default(false)
  verifiedById String?      @db.VarChar(36)
  verifiedAt   DateTime?
  notes        String?      @db.Text
  expiresAt    DateTime?
  uploadedById String       @db.VarChar(36)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("CompanyDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  verifiedBy User?   @relation("CompanyDocumentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([companyId, type])
  @@index([uploadedById])
  @@index([verifiedById])
  @@index([deletedAt])
  @@map("company_documents")
}

// ============================================================================
//  FOREST RESOURCE DATA
// ============================================================================

model Forest {
  id                    String       @id @default(uuid()) @db.VarChar(36)
  code                  String       @unique @db.VarChar(40)
  name                  String       @db.VarChar(191)
  description           String?      @db.Text
  type                  ForestType
  status                ForestStatus @default(ACTIVE)
  region                String       @db.VarChar(96)
  division              String?      @db.VarChar(96)
  subdivision           String?      @db.VarChar(96)
  totalAreaHa           Decimal      @db.Decimal(14, 2)
  exploitableAreaHa     Decimal?     @db.Decimal(14, 2)
  latitude              Decimal      @db.Decimal(10, 7)
  longitude             Decimal      @db.Decimal(10, 7)
  boundaryGeoJson       String?      @db.LongText
  elevationM            Int?
  annualAllowableCutM3  Decimal?     @db.Decimal(14, 2)
  establishedAt         DateTime?
  lastInventoriedAt     DateTime?
  isPublic              Boolean      @default(true)
  isDemo                Boolean      @default(false)
  protectedAreaId       String?      @db.VarChar(36)
  managedById           String?      @db.VarChar(36)
  createdById           String       @db.VarChar(36)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  protectedArea ProtectedArea?         @relation(fields: [protectedAreaId], references: [id], onDelete: SetNull)
  managedBy     User?                  @relation("ForestManager", fields: [managedById], references: [id], onDelete: SetNull)
  createdBy     User                   @relation("ForestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  zones         ForestZone[]
  inventories   TreeInventory[]
  permits       ExploitationPermit[]
  activities    ExploitationActivity[]
  inspections   Inspection[]
  observations  FieldObservation[]
  violations    EnvironmentalViolation[]
  aiAlerts      AIAlert[]
  reports       Report[]
  gisLocations  GISLocation[]
  fieldSessions FieldSession[]

  @@index([status])
  @@index([region])
  @@index([type])
  @@index([protectedAreaId])
  @@index([managedById])
  @@index([deletedAt])
  @@map("forests")
}

model ForestZone {
  id                   String     @id @default(uuid()) @db.VarChar(36)
  forestId             String     @db.VarChar(36)
  code                 String     @db.VarChar(40)
  name                 String     @db.VarChar(191)
  zoneType             ZoneType
  status               ZoneStatus @default(ACTIVE)
  areaHa               Decimal    @db.Decimal(14, 2)
  latitude             Decimal    @db.Decimal(10, 7)
  longitude            Decimal    @db.Decimal(10, 7)
  boundaryGeoJson      String?    @db.LongText
  maxAnnualYieldM3     Decimal?   @db.Decimal(14, 2)
  conservationPriority Int        @default(0)
  isProtected          Boolean    @default(false)
  description          String?    @db.Text
  lastHarvestedAt      DateTime?
  isDemo               Boolean    @default(false)
  createdById          String     @db.VarChar(36)
