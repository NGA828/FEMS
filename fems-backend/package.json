{
  "name": "fems-backend",
  "version": "1.0.0",
  "description": "FEMS NestJS API \u2014 forest exploitation management, permits, payments, inspections, GIS and AI forest intelligence.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "node scripts/prisma-generate.mjs",
    "prisma:validate": "node scripts/prisma-validate.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:drift": "node scripts/verify-schema-drift.mjs",
    "db:seed": "node --import tsx scripts/seed-runner.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "db:studio": "prisma studio",
    "db:status": "prisma migrate status",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.mjs\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:cov": "jest --config jest.config.js --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "smoke:payments": "node scripts/smoke-payments.mjs",
    "smoke:inspections": "node scripts/smoke-inspections.mjs",
    "smoke:environmental": "node scripts/smoke-environmental.mjs",
    "postinstall": "node scripts/prisma-generate.mjs || echo 'prisma client generation skipped - run npm run prisma:generate'",
    "smoke:reports": "node scripts/smoke-reports.mjs",
    "smoke:ai": "node scripts/smoke-ai.mjs",
    "seed:verify": "node scripts/verify-seed.mjs",
    "verify:access": "node scripts/verify-access-scope.mjs",
    "db:mysql": "node scripts/dev-mysql.mjs start",
    "db:mysql:stop": "node scripts/dev-mysql.mjs stop",
    "db:mysql:status": "node scripts/dev-mysql.mjs status"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/websockets": "^11.2.6",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "helmet": "^8.1.0",
    "mariadb": "^3.4.5",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.6",
    "@prisma/client-generator-js": "7.10.0",
    "@prisma/engines-version": "7.10.0-4.0edf323efd1d98336f3f0a68684b56f689b900d3",
    "@prisma/internals": "7.10.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.4",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "prisma": "7.10.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  }
}
