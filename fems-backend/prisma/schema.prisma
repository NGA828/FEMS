  estimatedDamageXAF  Decimal?          @db.Decimal(14, 2)
  penaltyAmountXAF    Decimal?          @db.Decimal(14, 2)
  remediationRequired Boolean           @default(false)
  remediationDeadline DateTime?
  remediationNotes    String?           @db.Text
  investigationNotes  String?           @db.Text
  resolvedAt          DateTime?
  resolvedById        String?           @db.VarChar(36)
  resolutionSummary   String?           @db.Text
  isDemo              Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  forest        Forest                @relation(fields: [forestId], references: [id], onDelete: Restrict)
  zone          ForestZone?           @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  protectedArea ProtectedArea?        @relation(fields: [protectedAreaId], references: [id], onDelete: SetNull)
  company       Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  permit        ExploitationPermit?   @relation(fields: [permitId], references: [id], onDelete: SetNull)
  activity      ExploitationActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  inspection    Inspection?           @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  observation   FieldObservation?     @relation(fields: [observationId], references: [id], onDelete: SetNull)
  detectedBy    User                  @relation("ViolationDetector", fields: [detectedById], references: [id], onDelete: Restrict)
  resolvedBy    User?                 @relation("ViolationResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  payments      Payment[]
  evidences     Evidence[]
  gisLocations  GISLocation[]

  @@index([status, severity])
  @@index([forestId])
  @@index([zoneId])
  @@index([protectedAreaId])
  @@index([companyId])
  @@index([permitId])
  @@index([activityId])
  @@index([inspectionId])
  @@index([detectedAt])
  @@index([deletedAt])
  @@map("environmental_violations")
}

model Evidence {
  id                String         @id @default(uuid()) @db.VarChar(36)
  type              EvidenceType
  source            EvidenceSource @default(FILE_UPLOAD)
  title             String?        @db.VarChar(191)
  caption           String?        @db.VarChar(500)
  fileUrl           String         @db.VarChar(512)
  fileKey           String         @db.VarChar(255)
  mimeType          String         @db.VarChar(120)
  sizeBytes         Int
  checksum          String?        @db.VarChar(64)
  latitude          Decimal?       @db.Decimal(10, 7)
  longitude         Decimal?       @db.Decimal(10, 7)
  locationAccuracyM Decimal?       @db.Decimal(8, 2)
  capturedAt        DateTime?
  gpsSource         GpsSource?
  inspectionId      String?        @db.VarChar(36)
  activityId        String?        @db.VarChar(36)
  observationId     String?        @db.VarChar(36)
  violationId       String?        @db.VarChar(36)
  permitId          String?        @db.VarChar(36)
  companyId         String?        @db.VarChar(36)
  uploadedById      String         @db.VarChar(36)
  syncStatus        SyncStatus     @default(SYNCED)
  clientRef         String?        @unique @db.VarChar(64)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  inspection  Inspection?             @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  activity    ExploitationActivity?   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  observation FieldObservation?       @relation(fields: [observationId], references: [id], onDelete: Cascade)
  violation   EnvironmentalViolation? @relation(fields: [violationId], references: [id], onDelete: Cascade)
  permit      ExploitationPermit?     @relation(fields: [permitId], references: [id], onDelete: Cascade)
  company     Company?                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy  User                    @relation("EvidenceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([inspectionId])
  @@index([activityId])
  @@index([observationId])
  @@index([violationId])
  @@index([permitId])
  @@index([companyId])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("evidences")
}

// ============================================================================
//  REPORTS, NOTIFICATIONS, GIS
// ============================================================================

model Report {
  id              String        @id @default(uuid()) @db.VarChar(36)
  reference       String        @unique @db.VarChar(48)
  type            ReportType
  format          ReportFormat  @default(JSON)
  status          ReportStatus  @default(DRAFT)
  title           String        @db.VarChar(191)
  parametersJson  String?       @db.LongText
  summaryJson     String?       @db.LongText
  dateFrom        DateTime?
  dateTo          DateTime?
  forestId        String?       @db.VarChar(36)
  zoneId          String?       @db.VarChar(36)
  protectedAreaId String?       @db.VarChar(36)
  companyId       String?       @db.VarChar(36)
  permitId        String?       @db.VarChar(36)
  fileUrl         String?       @db.VarChar(512)
  fileKey         String?       @db.VarChar(255)
  sizeBytes       Int?
  generatedById   String        @db.VarChar(36)
  generatedAt     DateTime?
  errorMessage    String?       @db.VarChar(500)
  isDemo          Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  forest        Forest?             @relation(fields: [forestId], references: [id], onDelete: SetNull)
  protectedArea ProtectedArea?      @relation(fields: [protectedAreaId], references: [id], onDelete: SetNull)
  company       Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  permit        ExploitationPermit? @relation(fields: [permitId], references: [id], onDelete: SetNull)
  generatedBy   User                @relation("ReportGenerator", fields: [generatedById], references: [id], onDelete: Restrict)

  @@index([type, status])
  @@index([generatedById])
  @@index([forestId])
  @@index([companyId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("reports")
}

model Notification {
  id             String            @id @default(uuid()) @db.VarChar(36)
  userId         String            @db.VarChar(36)
  type           NotificationType
  title          String            @db.VarChar(191)
  message        String            @db.VarChar(500)
  entityType     String?           @db.VarChar(64)
  entityId       String?           @db.VarChar(64)
  actionUrl      String?           @db.VarChar(255)
  severity       AuditSeverity     @default(INFO)
  readAt         DateTime?
  deliveredInApp Boolean           @default(true)
  deliveredPush  Boolean           @default(false)
  deliveredEmail Boolean           @default(false)
  createdAt      DateTime          @default(now())
  expiresAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

model NotificationPreference {
  id           String           @id @default(uuid()) @db.VarChar(36)
  userId       String           @db.VarChar(36)
  type         NotificationType
  inAppEnabled Boolean          @default(true)
  pushEnabled  Boolean          @default(true)
  emailEnabled Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("notification_preferences")
}

model GISLocation {
  id              String         @id @default(uuid()) @db.VarChar(36)
  featureType     GisFeatureType
  entityId        String         @db.VarChar(36)
  label           String         @db.VarChar(191)
  latitude        Decimal        @db.Decimal(10, 7)
  longitude       Decimal        @db.Decimal(10, 7)
  elevationM      Int?
  accuracyM       Decimal?       @db.Decimal(8, 2)
  source          GpsSource      @default(SYSTEM_RECORDED)
  forestId        String?        @db.VarChar(36)
  zoneId          String?        @db.VarChar(36)
  protectedAreaId String?        @db.VarChar(36)
  activityId      String?        @db.VarChar(36)
  inspectionId    String?        @db.VarChar(36)
  observationId   String?        @db.VarChar(36)
  violationId     String?        @db.VarChar(36)
  aiAlertId       String?        @db.VarChar(36)
  recordedById    String?        @db.VarChar(36)
  recordedAt      DateTime       @default(now())
  isDemo          Boolean        @default(false)
  metadataJson    String?        @db.LongText
  createdAt       DateTime       @default(now())

  forest        Forest?                @relation(fields: [forestId], references: [id], onDelete: Cascade)
  zone          ForestZone?            @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  protectedArea ProtectedArea?         @relation(fields: [protectedAreaId], references: [id], onDelete: Cascade)
  activity      ExploitationActivity?  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  inspection    Inspection?            @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  observation   FieldObservation?      @relation(fields: [observationId], references: [id], onDelete: Cascade)
  violation     EnvironmentalViolation? @relation(fields: [violationId], references: [id], onDelete: Cascade)
  aiAlert       AIAlert?               @relation(fields: [aiAlertId], references: [id], onDelete: Cascade)
  recordedBy    User?                  @relation("LocationRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([featureType, entityId])
  @@index([latitude, longitude])
  @@index([forestId])
  @@index([zoneId])
  @@index([protectedAreaId])
  @@index([activityId])
  @@index([inspectionId])
  @@index([observationId])
  @@index([violationId])
  @@index([aiAlertId])
  @@map("gis_locations")
}

// ============================================================================
//  AI — FOREST INTELLIGENCE & FOREST ASSISTANT
// ============================================================================

model AIAnalysis {
  id            String           @id @default(uuid()) @db.VarChar(36)
  type          AiAnalysisType
  status        AiAnalysisStatus @default(PENDING)
  provider      AiProvider       @default(LOCAL_RULE_ENGINE)
  model         String?          @db.VarChar(96)
  promptText    String?          @db.LongText
  responseJson  String?          @db.LongText
  resultJson    String?          @db.LongText
  summary       String?          @db.Text
  riskLevel     RiskLevel?
  confidence    Decimal?         @db.Decimal(5, 4)
  entityType    String?          @db.VarChar(64)
  entityId      String?          @db.VarChar(64)
  forestId      String?          @db.VarChar(36)
  zoneId        String?          @db.VarChar(36)
  latencyMs     Int?
  tokensUsed    Int?
  errorMessage  String?          @db.VarChar(500)
  requestedById String?          @db.VarChar(36)
  reviewedById  String?          @db.VarChar(36)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  requestedBy User?     @relation("AnalysisRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy  User?     @relation("AnalysisReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  alerts      AIAlert[]

  @@index([type, status])
  @@index([entityType, entityId])
  @@index([forestId])
  @@index([requestedById])
  @@index([createdAt])
  @@map("ai_analyses")
}

model AIAlert {
  id               String      @id @default(uuid()) @db.VarChar(36)
  reference        String      @unique @db.VarChar(48)
  type             AlertType
  status           AlertStatus @default(NEW)
  riskLevel        RiskLevel   @default(LOW)
  confidence       Decimal?    @db.Decimal(5, 4)
  title            String      @db.VarChar(191)
  description      String      @db.Text
  reasoning        String?     @db.Text
  detector         AiProvider  @default(LOCAL_RULE_ENGINE)
  analysisId       String?     @db.VarChar(36)
  entityType       String?     @db.VarChar(64)
  entityId         String?     @db.VarChar(64)
  forestId         String?     @db.VarChar(36)
  zoneId           String?     @db.VarChar(36)
  protectedAreaId  String?     @db.VarChar(36)
  companyId        String?     @db.VarChar(36)
  permitId         String?     @db.VarChar(36)
  activityId       String?     @db.VarChar(36)
  inspectionId     String?     @db.VarChar(36)
  observationId    String?     @db.VarChar(36)
  latitude         Decimal?    @db.Decimal(10, 7)
  longitude        Decimal?    @db.Decimal(10, 7)
  detectedAt       DateTime    @default(now())
  reviewedById     String?     @db.VarChar(36)
  reviewedAt       DateTime?
  reviewNotes      String?     @db.Text
  resolutionAction String?     @db.VarChar(500)
  resolvedAt       DateTime?
  violationId      String?     @db.VarChar(36)
  isDemo           Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  analysis      AIAnalysis?           @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  forest        Forest?               @relation(fields: [forestId], references: [id], onDelete: SetNull)
  zone          ForestZone?           @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  protectedArea ProtectedArea?        @relation(fields: [protectedAreaId], references: [id], onDelete: SetNull)
  company       Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  permit        ExploitationPermit?   @relation(fields: [permitId], references: [id], onDelete: SetNull)
  activity      ExploitationActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  inspection    Inspection?           @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  observation   FieldObservation?     @relation(fields: [observationId], references: [id], onDelete: SetNull)
  reviewedBy    User?                 @relation("AlertReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  gisLocations  GISLocation[]

  @@index([status, riskLevel])
  @@index([type])
  @@index([forestId])
  @@index([zoneId])
  @@index([protectedAreaId])
  @@index([companyId])
  @@index([permitId])
  @@index([activityId])
  @@index([inspectionId])
  @@index([observationId])
  @@index([reviewedById])
  @@index([detectedAt])
  @@map("ai_alerts")
}

model AIConversation {
  id            String   @id @default(uuid()) @db.VarChar(36)
  userId        String   @db.VarChar(36)
  title         String?  @db.VarChar(191)
  contextJson   String?  @db.LongText
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  archivedAt    DateTime?

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, lastMessageAt])
  @@map("ai_conversations")
}

model AIMessage {
  id             String     @id @default(uuid()) @db.VarChar(36)
  conversationId String     @db.VarChar(36)
  role           ChatRole
  content        String     @db.LongText
  provider       AiProvider?
  model          String?    @db.VarChar(96)
  intentJson     String?    @db.LongText
  dataRefsJson   String?    @db.LongText
  latencyMs      Int?
  tokensUsed     Int?
  errorMessage   String?    @db.VarChar(500)
  createdAt      DateTime   @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum MediaOwnerType {
  FOREST
  PROTECTED_AREA
  TREE_SPECIES
  HERO
  BRAND
}

enum MediaRole {
  COVER
  GALLERY
  HERO
  LOGO
}

model MediaAsset {
  id        String         @id @default(uuid()) @db.VarChar(36)
  ownerType MediaOwnerType
  ownerId   String?        @db.VarChar(36)
  role      MediaRole      @default(COVER)
  title     String?        @db.VarChar(191)
  altText   String?        @db.VarChar(300)
  credit    String?        @db.VarChar(191)
  mimeType  String         @db.VarChar(64)
  width     Int
  height    Int
  sizeBytes Int
  data      Bytes          @db.LongBlob
  isDemo    Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([ownerType, ownerId])
  @@index([role])
  @@index([ownerType, role, sortOrder])
  @@map("media_assets")
}
