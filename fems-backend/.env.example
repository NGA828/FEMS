# ============================================================================
#  FEMS Backend — environment configuration (copy to .env and edit)
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=*
# Production: list the exact origins instead, e.g.
# CORS_ORIGINS=https://app.fems.cm,https://admin.fems.cm

# --- Database (MySQL 8 / MariaDB 10.4+ / MySQL 5.7+) -----------------------
DATABASE_URL="mysql://fems:fems@127.0.0.1:3306/fems"

# For XAMPP's default MySQL setup, use:
# DATABASE_URL="mysql://root:@127.0.0.1:3306/fems"

# --- JWT / authentication --------------------------------------------------
JWT_SECRET=change-me-development-only-secret-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-development-only-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_RESET_TTL_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- File storage ----------------------------------------------------------
# driver: local | s3  (s3 requires AWS_* below)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_URL=http://localhost:3000/api/v1/files
MAX_UPLOAD_SIZE_MB=15
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Payments (Campay) -----------------------------------------------------
# provider: campay | simulator
# "simulator" is an explicitly-labelled local ledger used for demos/tests when
# Campay credentials are unavailable; it never claims a real Campay transaction.
PAYMENT_PROVIDER=simulator
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_API_KEY=
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_WEBHOOK_SECRET=
CAMPAY_CURRENCY=XAF

# --- AI (Google Gemini) ----------------------------------------------------
# When GEMINI_API_KEY is empty the AI module reports "not configured" and the
# deterministic LOCAL_RULE_ENGINE (real statistical analysis) is used instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Request timeout for a single Gemini call, in milliseconds.
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2048
# An alert that has not been reviewed within this many hours is flagged overdue.
AI_ALERT_REVIEW_SLA_HOURS=72
AI_RISK_SCHEDULE_ENABLED=true

# --- Notifications ---------------------------------------------------------
# provider: none | expo | smtp
PUSH_PROVIDER=none
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FEMS <no-reply@fems.cm>"
PERMIT_EXPIRY_WARN_DAYS=30

# --- GIS -------------------------------------------------------------------
# Tiles are rendered by the mobile client; this URL is returned by /gis/config.
MAPS_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GIS_DEFAULT_CENTER_LAT=3.8480
GIS_DEFAULT_CENTER_LNG=11.5021
GIS_DEFAULT_ZOOM=7
GIS_NEARBY_RADIUS_KM=50

# --- Security --------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
BCRYPT_ROUNDS=10
