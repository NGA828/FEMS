# ============================================================================
#  FEMS Backend — environment configuration (copy to .env and edit)
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=*
# Production: list the exact origins instead, e.g.
# CORS_ORIGINS=https://app.fems.cm,https://admin.fems.cm

# --- Database (MySQL 8 / MariaDB 10.4+ / MySQL 5.7+) -----------------------
#DATABASE_URL="mysql://fems:fems@127.0.0.1:3306/fems"

# For XAMPP's default MySQL setup, use:
 DATABASE_URL="mysql://root:@127.0.0.1:3306/fems"

# --- JWT / authentication --------------------------------------------------
JWT_SECRET=change-me-development-only-secret-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-development-only-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_RESET_TTL_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- File storage ----------------------------------------------------------
# driver: local | s3  (s3 requires AWS_* below)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_URL=http://localhost:3000/api/v1/files
MAX_UPLOAD_SIZE_MB=15
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Payments (Campay) -----------------------------------------------------
# provider: campay | simulator
# "simulator" is an explicitly-labelled local ledger used for demos/tests when
# Campay credentials are unavailable; it never claims a real Campay transaction.
PAYMENT_PROVIDER=simulator
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_API_KEY=
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_WEBHOOK_SECRET=
CAMPAY_CURRENCY=XAF

# --- AI provider -----------------------------------------------------------
# groq (default; the only external model provider) | none (local rules only)
AI_PROVIDER=groq

# GroqCloud — create an API key at https://console.groq.com/keys.
# The current production default is OpenAI GPT-OSS 120B hosted by Groq. If this
# key is empty, AI uses FEMS's deterministic rule engine and stays available.
GROQ_API_KEY=
# Active Groq model IDs can be checked with: npm run ai:verify -- --list
# The legacy llama-3.3-70b-versatile setting is automatically upgraded.
# Smaller alternative: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Request timeout for a single provider call, in milliseconds.
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2048
# An alert that has not been reviewed within this many hours is flagged overdue.
AI_ALERT_REVIEW_SLA_HOURS=72
AI_RISK_SCHEDULE_ENABLED=true

# --- Notifications ---------------------------------------------------------
# Push delivery: none | expo
PUSH_PROVIDER=none
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# --- Transactional email (SMTP) --------------------------------------------
# Used for: account verification codes, password-reset codes and the
# notification events whose EMAIL channel is enabled on the account.
#
# EMAIL_PROVIDER: none | smtp
#   none  -> nothing is sent. Outside production the API returns the
#            verification/reset code in the response so the flow stays testable.
#   smtp  -> messages go out through the SMTP server configured below.
# Leaving EMAIL_PROVIDER empty while SMTP_HOST is set is treated as "smtp".
#
# GMAIL / GOOGLE WORKSPACE SETUP
#   1. The sending account must have 2-Step Verification enabled.
#      https://myaccount.google.com/signinoptions/two-step-verification
#   2. Create an App password (16 characters, type "Mail"):
#      https://myaccount.google.com/apppasswords
#      A normal Google password will NOT work — Google rejects it with
#      "535-5.7.8 Username and Password not accepted".
#   3. Fill in the four values below. Paste the app password without spaces.
#   4. Restart the API: it logs "Email delivery ready: ..." at boot, or the
#      exact SMTP error if the credentials are refused.
#   5. Verify end-to-end: POST /api/v1/system/integrations/mail/test
#      (administrator only), or run `npm run mail:verify` from fems-backend.
#
#   SMTP_FROM must be the same mailbox as SMTP_USER (or an alias it owns),
#   otherwise Gmail rewrites or rejects the sender.
#
# Port 587 = STARTTLS (recommended). Port 465 = implicit TLS, also supported.
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FEMS <no-reply@fems.cm>"

# Working Gmail example (copy these four lines, replace the address and the
# app password, and set EMAIL_PROVIDER=smtp):
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=fems.notifications@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
# SMTP_FROM="FEMS <fems.notifications@gmail.com>"

PERMIT_EXPIRY_WARN_DAYS=30

# --- GIS -------------------------------------------------------------------
# Tiles are rendered by the mobile client; this URL is returned by /gis/config.
MAPS_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GIS_DEFAULT_CENTER_LAT=3.8480
GIS_DEFAULT_CENTER_LNG=11.5021
GIS_DEFAULT_ZOOM=7
GIS_NEARBY_RADIUS_KM=50

# --- Security --------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
BCRYPT_ROUNDS=10
