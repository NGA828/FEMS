// ============================================================================
//  FEMS — Forest Exploitation Management System
//  Prisma schema (MySQL / MariaDB)
// ============================================================================
//  * Connection URLs live in `prisma.config.ts` (Prisma 7+); never in this file.
//  * MySQL 5.6 has no native JSON column, therefore JSON payloads are stored as
//    `@db.LongText` in fields suffixed `Json` and (de)serialised by the
//    application layer (see docs/database.md).
//  * GIS: points are validated DECIMAL(10,7) lat/lng pairs and area boundaries
//    are GeoJSON (LongText) so the schema stays portable across MySQL 5.6/8.x.
//    See docs/database.md "GIS strategy" for the spatial-column upgrade path.
//  * Soft deletion (`deletedAt`) is used for records that must stay auditable.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

